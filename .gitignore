# ---- ARCH-11：备份/临时残余兜底（防止 git add -A 误提交开发期备份）----
# 编辑器/VCS 手工备份后缀（如 efmi_deform.hlsl.bak-freeze-20260911-070026、
# node_postprocess_draginteraction_efmi.py.bak-t51-20260911-093407、*.GOOD-*）
*.bak
*.bak-*
*.bak.*
*.GOOD-*
*.orig
*.rej
*~
# 验证/诊断日志（如 tests/_verify_efmi_contract.log，全仓零引用）
tests/_verify_*.log
# review 期间产出的临时 diff（如 .review_t1_zzmi.diff）
.review_*.diff
# 评审工作产物整目录不入库（报告 md / 补丁 / 归档 zip / 验证日志 / 临时脚本，
# 全仓零引用且从未入库；需要把某一份报告留档时用 git add -f 单独强加）
review-reports/

# ZZMI / FrameAnalysis 排查用的临时脚本与日志（本地诊断产物，全仓零引用）
zzz_diag/
# 本地模组副本审计产物（8 个变体目录 + INDEX.md，4822 个文件 / 约 2.9 GB，
# 全仓零引用、从未入库；需要留档某一份时用 git add -f 单独强加）
variants/
# 根目录 _verify/：跨显卡排查期的一次性验证脚本（v1_slide.py 等，全仓零引用，
# 不属于任何功能改动；需要留档时用 git add -f 单独强加）
_verify/

# notes/：himi family / cross-group palette 调试线的工作台（FrameAnalysis 抓帧 buf、
# 一次性 .mjs 脚本、着色器变体与定案 md；22 项全仓零引用、从未入库，
# 其中 family_x.py 与已就位的 common/himi_family_x.py 逐字节相同。
# 需要留档某一份时用 git add -f 单独强加）
notes/

